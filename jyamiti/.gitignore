# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing keys
**/android/key.properties
**/android/app/*.jks

# Bundled ffmpeg.exe for Math Pad recording (windows/CMakeLists.txt installs
# it into the build output) -- ~80MB binary, deliberately not committed;
# see windows/third_party/ffmpeg/NOTICE.txt for how to (re)fetch it.
windows/third_party/ffmpeg/*.exe
windows/third_party/ffmpeg/*.zip

